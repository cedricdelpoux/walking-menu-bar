{
  "name": "walkingpad-menu-bar",
  "version": "0.2.0",
  "description": "Unofficial macOS menu bar app to drive a KingSmith WalkingPad and publish your walks to Strava",
  "author": "Cédric Delpoux",
  "license": "MIT",
  "repository": "github:cedricdelpoux/walkingpad-menu-bar",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc -p . && tsc -p src/renderer",
    "lint": "eslint .",
    "format": "prettier --write .",
    "probe": "tsx scripts/ble-probe.ts",
    "record": "ELECTRON_RUN_AS_NODE=1 electron node_modules/tsx/dist/cli.mjs scripts/record.ts",
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "dist": "electron-vite build && electron-builder --mac --arm64 --config electron-builder.config.cjs"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.214.0",
    "@stoprocent/noble": "^2.8.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": true,
    "@stoprocent/noble": true,
    "electron-winstaller": false,
    "usb": false,
    "@serialport/bindings-cpp": false,
    "@stoprocent/bluetooth-hci-socket": false
  },
  "productName": "WalkingBar"
}
